GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Firebase web configuration is public by design; never put Admin SDK credentials here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-only Cloud Function base URL, for example:
# https://us-central1-your-project.cloudfunctions.net/api
FIREBASE_API_URL=
# Firebase Functions-only secrets. Set with `firebase functions:secrets:set`;
# never expose these values to Vercel or browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
